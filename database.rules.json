{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".indexOn": [
        "points",
        "email"
      ],
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || (auth != null && (auth.token.email == 'admin@admin.com' || root.child('users').child(auth.uid).child('role').val() == 'teacher')))",
        ".write": "(auth != null && (auth.token.email == 'admin@admin.com' || root.child('users').child(auth.uid).child('role').val() == 'teacher')) || (auth != null && auth.uid == $uid && !data.exists() && newData.child('role').val() == 'student' && newData.child('points').val() == 0 && newData.child('authEmail').val() == auth.token.email && !newData.child('brainRewards').exists() && !newData.child('practiceRewards').exists() && !newData.child('purchaseReceipts').exists())",
        ".validate": "newData.hasChildren(['email', 'authEmail', 'role', 'points', 'name'])",
        "name": {
          ".write": "auth != null && auth.uid == $uid && data.parent().exists()",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        }
      }
    },
    "dailyChallenges": {
      "$dateKey": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.email == 'admin@admin.com' || root.child('users').child(auth.uid).child('role').val() == 'teacher')"
      }
    },
    "challengeAnswers": {
      "$dateKey": {
        ".read": "auth != null && (auth.token.email == 'admin@admin.com' || root.child('users').child(auth.uid).child('role').val() == 'teacher')",
        ".write": "auth != null && (auth.token.email == 'admin@admin.com' || root.child('users').child(auth.uid).child('role').val() == 'teacher')"
      }
    },
    "submissions": {
      "$submissionId": {
        ".read": "auth != null && (data.child('uid').val() == auth.uid || auth.token.email == 'admin@admin.com' || root.child('users').child(auth.uid).child('role').val() == 'teacher')",
        ".write": "auth != null && (!data.exists() && newData.child('uid').val() == auth.uid && newData.child('status').val() == 'pending')"
      }
    },
    "storeProducts": {
      ".read": "auth != null",
      ".indexOn": [
        "createdAt",
        "visible"
      ],
      "$productId": {
        ".write": "auth != null && (auth.token.email == 'admin@admin.com' || root.child('users').child(auth.uid).child('role').val() == 'teacher')"
      }
    },
    "purchases": {
      "$purchaseId": {
        ".read": "auth != null && (data.child('uid').val() == auth.uid || auth.token.email == 'admin@admin.com' || root.child('users').child(auth.uid).child('role').val() == 'teacher')",
        ".write": false
      }
    },
    "challengeWinners": {
      "$winnerId": {
        ".read": "auth != null",
        ".write": false
      }
    },
    "auctions": {
      ".read": "auth != null",
      ".indexOn": [
        "visible",
        "endsAt"
      ],
      "$auctionId": {
        ".write": "auth != null && (auth.token.email == 'admin@admin.com' || root.child('users').child(auth.uid).child('role').val() == 'teacher')"
      }
    },
    "bids": {
      "$bidId": {
        ".read": "auth != null && (data.child('uid').val() == auth.uid || auth.token.email == 'admin@admin.com' || root.child('users').child(auth.uid).child('role').val() == 'teacher')",
        ".write": "auth != null && !data.exists() && newData.child('uid').val() == auth.uid && newData.child('amount').isNumber() && newData.child('amount').val() > 0"
      }
    },
    "brain": {
      ".write": false,
      "daily": {
        "$day": {
          ".read": "auth != null"
        }
      },
      "best": {
        ".read": "auth != null"
      },
      "sessions": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid"
        }
      },
      "history": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid"
        }
      }
    },
    "pointLeaderboard": {
      ".read": "auth != null",
      ".write": false
    }
  }
}
